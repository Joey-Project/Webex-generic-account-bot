#!/usr/bin/env -S -i PATH=/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 /usr/bin/node

const process = require('node:process');
let exitStatusForError = () => 1;

import('./prepare-activation-reboot-challenge.mjs')
  .then((module) => {
    exitStatusForError = module.exitStatusForError;
    return module.runCli();
  })
  .then((code) => {
    process.exitCode = code;
  })
  .catch((error) => {
    process.stderr.write(`prepare-activation-reboot-challenge: ${error.message}\n`);
    process.exitCode = exitStatusForError(error);
  });
